_:ne271b94d13ee4d97bda185a796df7045b18 sh:message "Country profile has no display name; investigate the source-to-trade country-name match." ;
    sh:minCount 1 ;
    sh:path ul:name ;
    sh:severity sh:Warning .

_:ne271b94d13ee4d97bda185a796df7045b19 sh:message "The strategic-role label appears inconsistent with the numeric net trade balance; investigate the source label." ;
    sh:prefixes <https://ul.edu.lb/kr/shapes/semiconductor> ;
    sh:select """\r
            SELECT $this ?balance ?role WHERE {\r
                $this ul:netTradeBalanceUsd ?balance ;\r
                      ul:strategicRole ?role .\r
                FILTER (\r
                    (?balance < 0 &&\r
                        CONTAINS(LCASE(STR(?role)), "exporter")) ||\r
                    (?balance > 0 &&\r
                        CONTAINS(LCASE(STR(?role)), "importer"))\r
                )\r
            }\r
        """ .

