@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ul: <https://ul.edu.lb/kr/scm#> .

<https://ul.edu.lb/kr/scm> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

ul:exportedBy rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain ul:TradeObservation ;
              rdfs:range ul:Country .

ul:importedBy rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain ul:TradeObservation ;
              rdfs:range ul:Country .

ul:hasTier rdf:type owl:ObjectProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain ul:TradeObservation ;
           rdfs:range ul:Tier .

ul:feeds rdf:type owl:ObjectProperty ,
                  owl:TransitiveProperty ;
         rdfs:domain ul:Tier ;
         rdfs:range ul:Tier .


#################################################################
#    Data Properties
#################################################################

# --- TradeObservation Properties ---
ul:year rdf:type owl:DatatypeProperty ,
                 owl:FunctionalProperty ;
        rdfs:domain ul:TradeObservation ;
        rdfs:range xsd:integer .

ul:tradeValueUsd rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain ul:TradeObservation ;
                 rdfs:range xsd:decimal .

# --- Country Identification & Profile Properties ---
ul:name rdf:type owl:DatatypeProperty ,
                 owl:FunctionalProperty ;
        rdfs:domain ul:Country ;
        rdfs:range xsd:string .

ul:isoCode rdf:type owl:DatatypeProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain ul:Country ;
           rdfs:range xsd:string .

ul:totalExportUsd rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain ul:Country ;
                  rdfs:range xsd:decimal .

ul:totalImportUsd rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain ul:Country ;
                  rdfs:range xsd:decimal .

ul:netTradeBalanceUsd rdf:type owl:DatatypeProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain ul:Country ;
                      rdfs:range xsd:decimal .

ul:strategicRole rdf:type owl:DatatypeProperty ;
                 rdfs:domain ul:Country ;
                 rdfs:range xsd:string .

# --- Tier Properties ---
ul:categoryName rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain ul:Tier ;
                rdfs:range xsd:string .

ul:strategicBottleneck rdf:type owl:DatatypeProperty ;
                       rdfs:domain ul:Tier ;
                       rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

ul:Country rdf:type owl:Class .

ul:Tier rdf:type owl:Class .

ul:TradeObservation rdf:type owl:Class ;
                    rdfs:subClassOf [ rdf:type owl:Restriction ;
                                      owl:onProperty ul:exportedBy ;
                                      owl:onClass ul:Country ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty ul:hasTier ;
                                      owl:onClass ul:Tier ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty ul:importedBy ;
                                      owl:onClass ul:Country ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
                                    ] .

ul:SurplusCountry rdf:type owl:Class ;
                  rdfs:subClassOf ul:Country .

ul:DeficitCountry rdf:type owl:Class ;
                  rdfs:subClassOf ul:Country .

ul:BalancedCountry rdf:type owl:Class ;
                   rdfs:subClassOf ul:Country .


#################################################################
#    Disjoint Rules
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( ul:Country
                ul:Tier
                ul:TradeObservation
              )
] .

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( ul:BalancedCountry
                ul:DeficitCountry
                ul:SurplusCountry
              )
] .